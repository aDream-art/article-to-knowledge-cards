# 复制为 .env 后填写真实值（.env 已在 .gitignore 中，不会被提交）
# 也可以全部留空：后端会自动退回 mock 模式，对话链路仍可跑通

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=ai_chat
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 应用 ----------
# 上线务必换成一个随机 32 字节以上的字符串
JWT_SECRET=replace-with-a-random-32-bytes-string
# 没有 Key 时保持 true，用内置 mock provider 跑通全流程
CHAT_MOCK_ENABLED=true

# ---------- 模型 ----------
# 对话：DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 向量化：通义 DashScope（https://bailian.console.aliyun.com）
# 不填则 TXT 文档问答不可用（mock 向量没有语义）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
